# Required shared secret used by the FreeBuff Convex action.
RIS_PROXY_KEY=replace-with-a-long-random-secret

# Optional adapter credentials. Keep these in the deployment secret manager.
SAUCENAO_API_KEY=
BING_VISUAL_SEARCH_API_KEY=
# TinEye's API endpoint and authentication are account/plan-specific. The
# adapter remains unavailable until a permitted implementation is configured.
TINEYE_API_KEY=
TINEYE_API_URL=

# Browser automation (Google Lens adapter). The Docker image ships Chromium;
# see PLAYWRIGHT_BROWSERS_PATH below. GOOGLE_LENS_UPLOAD_URL can point at any
# compatible Lens upload-by-URL endpoint.
GOOGLE_LENS_UPLOAD_URL=https://lens.google.com/uploadbyurl
GOOGLE_LENS_RESULTS_TIMEOUT_MS=12000
RIS_BROWSER_HEADLESS=true
RIS_BROWSER_VIEWPORT_WIDTH=1366
RIS_BROWSER_VIEWPORT_HEIGHT=768
# Leave blank to let Playwright choose a default user agent.
RIS_BROWSER_USER_AGENT=
RIS_BROWSER_LOCALE=en-US
RIS_BROWSER_TIMEZONE=UTC

# Optional runtime tuning.
PORT=3000
RIS_MAX_CONCURRENCY=12
RIS_ADAPTER_TIMEOUT_MS=15000
RIS_MAX_RETRIES=2
RIS_CACHE_TTL_MS=300000
RIS_CACHE_MAX_ENTRIES=64
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Set this only if your deployment has a documented, permitted TinEye API.
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch
